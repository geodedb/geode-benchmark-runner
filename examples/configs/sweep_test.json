{
  "db": {
    "host": "127.0.0.1",
    "port": 3141,
    "transport": "quic_tls_insecure",
    "auth_token_env": "GEODE_TOKEN",
    "timeout_ms": 30000
  },
  "scenario": {
    "network_mode": "loopback",
    "durability": "fsync",
    "consistency": "serializable",
    "cache_state": "cold",
    "db_version": "0.1.0"
  },
  "workload": {
    "benchpack": "gdc_micro_primitives",
    "mode": "closed_loop",
    "duration_sec": 5,
    "workers": 2,
    "in_flight_per_worker": 5,
    "slo_ms": 100,
    "violation_threshold": 0.05,
    "error_threshold": 0.0
  }
}
