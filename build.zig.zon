.{
    .name = .graphbench,
    .version = "0.2.0",
    .fingerprint = 0xba90752dda55258f,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "benchpacks",
        "scripts",
        "README.md",
    },
    .dependencies = .{
        // =======================================================================
        // Geode Client Library
        // =======================================================================

        // Geode client library (QUIC-based graph database client)
        .geode_client = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#9a2a224249f6d948f91b9ee9889ae2864cc795fd",
            .hash = "geode_client_zig-0.1.0-8ysbV9gTAQA2AV4KArQZCF50pziBVtsNJ189Gjzczq4z",
        },

        // =======================================================================
        // Application Libraries
        // =======================================================================

        // CLI framework (Cobra/Viper-class features)
        .zig_cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#6b7dc6550afdd93b5c517dc7c5a920c2a67db0e6",
            .hash = "cli-0.1.0-0aso9F-vBAAoH-0L84gQXM4-y2NC_HzjU3KLsGEfBea3",
        },

        // YAML parser (YAML 1.2.2 compliant)
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#86fa9e5b19a1ad4bd743c5af65b64f3fda8be500",
            .hash = "yaml-0.1.1-lcW-hEyJBABZo0NG6sKHQkL4gciVKTQ4GLwXVeA2kpCe",
        },

        // =======================================================================
        // Core Libraries
        // =======================================================================

        // QUIC transport protocol (RFC 9000)
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#32c446db35358406f262f94fc6eea18a3ea9d791",
            .hash = "quic-0.1.6-gBIqUfVIOgB5ahkT-oJ4mdlJarjGs6WDUuQbuQih5Onl",
        },

        // TLS 1.3 cryptographic implementation
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#19af5cacdc995c497086e34fac6e392b991ec2f7",
            .hash = "tls-0.1.0-mtEaLFcLEgAin_NLt9lj8O_YjoaVGKX5GmPgTggZ_Wve",
        },

        // DNS resolution library
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#ca0b538871bb16f9f62d85241a011cc9d68e7b36",
            .hash = "dns-0.1.0-x4U-zR8ADAAz0rTIStt7xPq3LooZxn2Nr1HNQR6AAq6O",
        },

        // JSON parsing and serialization
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#c27aacfe656d0fd8678459033c33ab8de71bd56a",
            .hash = "json-0.1.0-tOue4WZ_CwDmY9dvdVfuFN_LcZZs6XcHmnQqkvsqdNCM",
        },

        // Multi-format configuration (YAML, TOML, JSON)
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#c00474c63019f787b021a3ec18e82e5c9891901d",
            .hash = "config-0.1.0-TiLumkzCBgAC8wIb_yGsG0NuqLyLR7aTNj_FF3EtzPCA",
        },

        // Structured logging with JSON output
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#638c63ad93ae8016f37b45fd5eda9838b4c17a38",
            .hash = "slog-0.1.0-SamED67fAwDghixIpZN48hgYrnT4CS8zcn4VcEN5jm67",
        },

        // URI parsing (RFC 3986/3987)
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#f4e818165aed79b8cf1dc0a2bc7812df90bb9cfd",
            .hash = "uri-0.1.0-zVvOsXZLAQAfg1wUuvR2yQC3FLtQPAV85R2aS6EFiaZn",
        },

        // String manipulation utilities
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#d0134c2f235de7c80fe8d8781becdb9b7c649f2c",
            .hash = "strings-0.1.0-adMOtbd1HABrved9iMt4lKxtonWX5dKNIWrdaWc2B5mo",
        },
    },
}
