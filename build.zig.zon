.{
    .name = .graphbench,
    .version = "0.2.0",
    .fingerprint = 0xba90752dda55258f,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "benchpacks",
        "scripts",
        "README.md",
    },
    .dependencies = .{
        // =======================================================================
        // Geode Client Library
        // =======================================================================

        // Geode client library (QUIC-based graph database client)
        .geode_client = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git?ref=main#2ea34907f34af593673ccd7d7cc3e5a6a22a87f5",
            .hash = "geode_client_zig-0.3.8-8ysbVz51CwBLqTjIVuUGfrJwluTgt3OZJ4e9CyhphstO",
        },

        // =======================================================================
        // Application Libraries
        // =======================================================================

        // CLI framework (Cobra/Viper-class features)
        .zig_cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git?ref=v0.1.14#75b181d1afcb4a3f246a4c08c3adf5f9895d6723",
            .hash = "cli-0.1.14-0aso9I9HCwDxOBxILQV8gOiOROxsEotN9GE0ILMZhD5h",
        },

        // YAML parser (YAML 1.2.2 compliant)
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git?ref=v0.1.10#d2455fdbc2676858988c94b4116ff11df65565a4",
            .hash = "yaml-0.1.10-lcW-hJ0sCAC3Ic7RLgYMLTI5r3HDCUT48ThG46wKCbGN",
        },

        // =======================================================================
        // Core Libraries
        // =======================================================================

        // QUIC transport protocol (RFC 9000)
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git?ref=v0.1.47#3ca1e9fc9a4b515cb9ed3fd5b3a3a6af4c38fcd1",
            .hash = "quic-0.1.47-gBIqUVmIQADARfwKza2h8HB4V8lrL4ZzRYNh6Vg67qUo",
        },

        // TLS 1.3 cryptographic implementation
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git?ref=v0.1.24#9518ef9fa5f2718c523ddccc04d4b68ff8bcb620",
            .hash = "tls-0.1.24-mtEaLGHFKgC0dE9AXYJJTmRdEwJbG2kcznZmGQbPyrut",
        },

        // DNS resolution library
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.27#d626b450b38a5311bcea295473ca3518269c3d7a",
            .hash = "dns-0.1.27-x4U-zWVmGACnzeUZhyK7IbPJTbAdKlSVGmqrK1kntUuB",
        },

        // JSON parsing and serialization
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git?ref=v0.1.20#22154db734abf5264a716086fc0669eb9d6c082a",
            .hash = "json-0.1.20-tOue4YSW6ACsmrKTooK2625fgWaZHPTZbu2R_EWVY4aU",
        },

        // Multi-format configuration (YAML, TOML, JSON)
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git?ref=v0.1.18#cf328f6f9c9d115fcafb573d2fec82f0c51fc0e8",
            .hash = "config-0.1.18-TiLumviyDABHAt1Am31WtoSYVORg1fPL0XagLW_YeNjK",
        },

        // Structured logging with JSON output
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git?ref=v0.1.15#6a5015cfc39e2d6e886983f88bada18dc98b8d59",
            .hash = "slog-0.1.15-SamEDyr7BwAE8WaNO8joc2QI1aqoX38PVFMAR7_KZuRS",
        },

        // URI parsing (RFC 3986/3987)
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git?ref=v0.1.16#e5e784ca6defa4cf897e6b18d9f08ef7336b588d",
            .hash = "uri-0.1.16-zVvOseGkAgDNDu5FLweN4VsghRQxNEDVC539D0_Dpgdi",
        },

        // String manipulation utilities
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git?ref=v0.1.6#a0de39afeaa103a49b4458882f42457077eeaede",
            .hash = "strings-0.1.6-adMOtbUoYwCleEij9NYkFEnisu2MZULZlL4tb1excHFe",
        },
    },
}
